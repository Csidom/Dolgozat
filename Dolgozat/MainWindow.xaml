<Window x:Class="Dolgozat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dolgozat"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="500">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Autókölcsönzés" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Text="Név:" FontSize="16"/>
            <TextBox x:Name="nev" Height="18"/>
            
            <TextBlock Text="Kor:" FontSize="16" Margin="0,5,0,0"/>
            <TextBox x:Name="kor" Height="18"/>

            <TextBlock Text="Jogosítvány száma:" FontSize="16" Margin="0,5,0,0"/>
            <TextBox x:Name="jogsi" Height="18"/>

            <TextBlock Text="Autó kiválasztása:" FontSize="16" Margin="0,5,0,0"/>
            <ComboBox x:Name="autovalaszt">
                <ComboBoxItem Content="Suzuki Swift – 12 000 Ft / nap"/>
                <ComboBoxItem Content="Toyota Corolla – 18 000 Ft / nap"/>
                <ComboBoxItem Content="BMW 3 – 30 000 Ft / nap"/>
                <ComboBoxItem Content="Tesla Model 3 – 35 000 Ft / nap"/>
            </ComboBox>

            <TextBlock Text="Bérlés időtartama:" FontSize="16" Margin="0,5,0,0"/>
            <TextBox x:Name="berlesido" Height="18"/>

            <TextBlock Text="Biztosítás:" FontSize="16" Margin="0,5,0,0"/>
            <RadioButton x:Name="biztositA" GroupName="biztositasok" Content="Alap biztosítás – ingyenes" Margin="10,5,0,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="biztositB" GroupName="biztositasok" Content="Extra biztosítás – +3000 Ft / nap" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="biztositC" GroupName="biztositasok" Content="Teljes biztosítás – +6000 Ft / nap" Margin="10,0,0,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Extrák: " FontSize="16" Margin="0,5,0,0"/>
            <CheckBox x:Name="gps" Content="GPS – +1000 Ft / nap" Margin="10,5,0,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="gyerekules" Content="Gyerekülés – +1500 Ft / nap" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="sofor" Content="Extra sofőr – +2500 Ft / nap" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="matrica" Content="Autópálya matrica – +5000 Ft egyszeri díj" Margin="10,0,0,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Fizetési mód:" FontSize="16" Margin="0,5,0,0"/>
            <RadioButton x:Name="fizetA" GroupName="fizetesmodok" Content="Készpénz" Margin="10,5,0,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="fizetB" GroupName="fizetesmodok" Content="Bankkártya" Margin="10,0,0,0" VerticalContentAlignment="Center"/>

            <CheckBox x:Name="feltetel" Content="Elfogadja a vásárlási feltételeket" FontSize="10" Margin="0,20,0,0" VerticalContentAlignment="Center"/>

            <Button Content="Foglalás" FontSize="20" Margin="10,15,10,0" Click="Foglalas"/>
            
            
        </StackPanel>
    </Grid>
</Window>
